+static atomic_bool monitor_enabled = false;
+static os_unfair_lock monitor_lock = OS_UNFAIR_LOCK_INIT;
+static struct ggml_metal_activity monitor_activity;
+
+void ggml_backend_metal_monitor_enable(bool enabled) {
+    atomic_store_explicit(&monitor_enabled, enabled, memory_order_relaxed);
+}
+
+void ggml_backend_metal_monitor_stats(struct ggml_metal_activity * stats) {
+    os_unfair_lock_lock(&monitor_lock);
+    *stats = monitor_activity;
+    os_unfair_lock_unlock(&monitor_lock);
+}
+
+static void ggml_metal_monitor_command(id<MTLCommandBuffer> command) {
+    if (!atomic_load_explicit(&monitor_enabled, memory_order_relaxed)) {
+        return;
+    }
+    [command addCompletedHandler:^(id<MTLCommandBuffer> completed) {
+        const double start = completed.GPUStartTime;
+        const double end = completed.GPUEndTime;
+        if (completed.status == MTLCommandBufferStatusCompleted && start > 0 && end >= start) {
+            os_unfair_lock_lock(&monitor_lock);
+            monitor_activity.command_nanoseconds += (uint64_t) ((end - start) * 1e9);
+            monitor_activity.command_count++;
+            os_unfair_lock_unlock(&monitor_lock);
+        }
+    }];
+}
 
